# Required: password agents type to open the app (any username works).
APP_PASSWORD=
# Required for Ask and Reply checker.
ANTHROPIC_API_KEY=
# Optional: Claude model id.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Required for the /editor page (team leads sign in with their name + this password).
EDITOR_PASSWORD=
# Required for the nightly refresh / Claude's direct updates (Authorization: Bearer <key>).
ADMIN_API_KEY=
# Set automatically by the Vercel DynamoDB integration:
# AWS_ROLE_ARN, AWS_REGION, DYNAMODB_TABLE_NAME, DYNAMODB_TABLE_PARTITION_KEY, DYNAMODB_TABLE_SORT_KEY
# Local testing only: point at DynamoDB Local / dynalite.
# DYNAMODB_ENDPOINT=http://localhost:4567
# "Check Master SOP" button (Zoho API Console > Server-based Applications):
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Public address of the site; the Zoho redirect URI is APP_URL + /api/editor/zoho/callback
APP_URL=https://customerservice2.vercel.app
# Optional: ZOHO_ACCOUNTS_URL (default https://accounts.zoho.com), ZOHO_API_URL (default https://www.zohoapis.com), SOP_FILE_ID
